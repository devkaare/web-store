package views

import (
	"github.com/devkaare/web-store/views/components"
)

templ SignUpPage() {
	@components.Base("Sign Up") {
		<div>
			<h1>Sign Up</h1>
			<form hx-post="/auth/signup" hx-target="this" hx-swap="outerHTML">
				<label for="first_name">First Name:</label>
				<input type="text" id="first_name" name="first_name" required/>
				<br/>
				<br/>
				<label for="last_name">Last Name:</label>
				<input type="text" id="last_name" name="last_name" required/>
				<br/>
				<br/>
				<label for="email">Email:</label>
				<input type="text" id="email" name="email" required/>
				<br/>
				<br/>
				<label for="password">Password:</label>
				<input type="text" id="password" name="password" required/>
				<br/>
				<br/>
				<label for="verif_password">Verify Password:</label>
				<input type="text" id="verif_password" name="verif_password" required/>
				<br/>
				<br/>
				<input type="submit" value="Submit"/>
			</form>
			<a href="/signin">Sign In</a>
		</div>
	}
}
