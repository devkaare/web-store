package views

import (
	"path/filepath"
	"fmt"

	"github.com/devkaare/web-store/views/components"
	"github.com/devkaare/web-store/slug"
	"github.com/devkaare/web-store/model"
)

type OrderItemProp struct {
	OrderItemID    int
	OrderDetailsID int
	ProductID      int
	Quantity       int
	Name           string
	Price          int
	ImagePath      string
}

templ OrderPage(orderItems []OrderItemProp, orderDetails *model.OrderDetails) {
	@components.Base("Order") {
		for _, p := range orderItems {
			<div>
				<img src={ fmt.Sprintf("%s", templ.URL(filepath.Join("/assets/product_imgs/", fmt.Sprintf("%s.png", slug.CreateSlug(p.Name))))) }/>
				<div>
					<a href={ templ.URL(fmt.Sprintf("/products/%d", p.ProductID)) }>{ p.Name }</a>
					<p>{ fmt.Sprintf("$%d", p.Price) }</p>
				</div>
				<p>{ fmt.Sprintf("%d", p.Quantity) }</p>
			</div>
		}
		<div>
			<h4>Total:</h4>
			<p>{ fmt.Sprintf("$%d", orderDetails.Total ) }</p>
		</div>
	}
}
