package views

import (
	"fmt"
	"path/filepath"

	"github.com/devkaare/web-store/views/components"
	"github.com/devkaare/web-store/slug"
)

type CartItemProp struct {
	CartItemID        int
	ShoppingSessionID int
	ProductID         int
	Quantity          int
	Name              string
	Price             int
	ImagePath         string
}

templ CartPage(cartItems []CartItemProp) {
	@components.Base("Cart") {
		for _, p := range cartItems {
			<div>
				<img src={ fmt.Sprintf("%s", templ.URL(filepath.Join("/assets/product-imgs/", fmt.Sprintf("%s.png", slug.CreateSlug(p.Name))))) }/>
				<div>
					<a href={ templ.URL(fmt.Sprintf("/products/%d", p.ProductID)) }>{ p.Name }</a>
					<p>{ fmt.Sprintf("%d", p.Price) }</p>
				</div>
				<p id="quantity">{ fmt.Sprintf("%d", p.Quantity) }</p>
				<form hx-target="#quantity" hx-swap="outerHTML" hx-post={ string(templ.URL(fmt.Sprintf("/cart/update/%d", p.CartItemID))) }>
					<input type="number" id="quantity" name="quantity" min="1" max="50"/>
					<button type="submit">UPDATE</button>
				</form>
				<form hx-target="#quantity" hx-swap="outerHTML" hx-post={ string(templ.URL(fmt.Sprintf("/cart/increment/%d", p.CartItemID))) }>
					<button type="submit">INCREMENT</button>
				</form>
				<form hx-target="#quantity" hx-swap="outerHTML" hx-post={ string(templ.URL(fmt.Sprintf("/cart/decrement/%d", p.CartItemID))) }>
					<button type="submit">DECREMENT</button>
				</form>
				<form hx-target="#quantity" hx-swap="outerHTML" hx-post={ string(templ.URL(fmt.Sprintf("/cart/remove/%d", p.CartItemID))) }>
					<button type="submit">REMOVE</button>
				</form>
			</div>
		}
	}
}
