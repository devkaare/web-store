package views

import (
	"fmt"
	"path/filepath"

	"github.com/devkaare/web-store/views/components"
	"github.com/devkaare/web-store/slug"
	"strconv"
)

type CartItemProp struct {
	CartItemID        int
	ShoppingSessionID int
	ProductID         int
	Quantity          int
	Name              string
	Price             int
	ImagePath         string
}

templ CartPage(cartItems []CartItemProp) {
	@components.Base("Cart") {
		for _, p := range cartItems {
			<div>
				<p id="quantity">{ fmt.Sprintf("%d", p.Quantity) }</p>
				<form hx-delete="/cart/delete" hx-params="cart_item_id" hx-target="#quantity" hx-swap="outerHTML">
					<input id="cart_item_id" name="cart_item_id" type="hidden" value={ strconv.Itoa(p.CartItemID) }/>
					<input type="submit" value="DELETE"/>
				</form>
				<form hx-patch="/cart/add" hx-params="cart_item_id" hx-target="#quantity" hx-swap="outerHTML">
					<input id="cart_item_id" name="cart_item_id" type="hidden" value={ strconv.Itoa(p.CartItemID) }/>
					<input type="submit" value="ADD"/>
				</form>
				<form hx-patch="/cart/remove" hx-params="cart_item_id" hx-target="#quantity" hx-swap="outerHTML">
					<input id="cart_item_id" name="cart_item_id" type="hidden" value={ strconv.Itoa(p.CartItemID) }/>
					<input type="submit" value="REMOVE"/>
				</form>
				<form hx-patch="/cart/update" hx-params="cart_item_id" hx-target="#quantity" hx-swap="outerHTML">
					<input id="cart_item_id" name="cart_item_id" type="hidden" value={ strconv.Itoa(p.CartItemID) }/>
					<input type="number" id="quantity" name="quantity" min="1" max="50"/>
					<input type="submit" value="REMOVE"/>
				</form>
				<img src={ fmt.Sprintf("%s", templ.URL(filepath.Join("/assets/product-imgs/", fmt.Sprintf("%s.png", slug.CreateSlug(p.Name))))) }/>
				<div>
					<a href={ templ.URL(fmt.Sprintf("/products/%d", p.ProductID)) }>{ p.Name }</a>
					<p>{ fmt.Sprintf("%d", p.Price) }</p>
				</div>
			</div>
		}
	}
}
