package components 

import "fmt"

templ Paginator(currentPage, lastPage int) {
	<div>
		<nav>
			<ul>
				<li><a class="btn-primary" href={ templ.URL(fmt.Sprintf("?page=%d", currentPage-1)) } rel="prev">Previous</a></li>
				<li><a class="btn-primary" href={ templ.URL(fmt.Sprintf("?page=%d", currentPage-1)) }>{ fmt.Sprintf("%d", currentPage-1) }</a></li>
				<li class="active"><a class="btn-primary" href={ templ.URL(fmt.Sprintf("?page=%d", currentPage)) }>{ fmt.Sprintf("%d", currentPage) }</a></li>
				if currentPage <= lastPage {
					<li><a class="btn-primary" href={ templ.URL(fmt.Sprintf("?page=%d", currentPage+1)) }>{ fmt.Sprintf("%d", currentPage+1) }</a></li>
					<li><a class="btn-primary" href={ templ.URL(fmt.Sprintf("?page=%d", currentPage+2)) }>{ fmt.Sprintf("%d", currentPage+2) }</a></li>
					<li><a class="btn-primary" href={ templ.URL(fmt.Sprintf("?page=%d", currentPage+1)) } rel="next">Next</a></li>
				}
			</ul>
		</nav>
	</div>
}
